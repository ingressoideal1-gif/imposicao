{
  "framework": null,
  "redirects": [
    { "source": "/evento.html", "destination": "/ic/evento.html" },
    { "source": "/portaria.html", "destination": "/ic/portaria.html" },
    { "source": "/controle.html", "destination": "/ic/controle.html" }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://imposicao.onrender.com/api/:path*"
    },
    { "source": "/ic", "destination": "/inicio.html" },
    { "source": "/ic/", "destination": "/inicio.html" },
    { "source": "/ic/:path*", "destination": "/:path*" },
    {
      "source": "/cliente/:match*",
      "destination": "/cliente.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.webmanifest)",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
